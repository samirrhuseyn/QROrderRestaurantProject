@model OrderRestaurantWebUI.Dtos.AboutDto.CreateAboutDto
@{
    ViewData["ActiveA"] = "active";
    ViewData["Title"] = "Create About";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="card">
    <form method="post" enctype="multipart/form-data">
        <div class="card-body col-md-12 pr-4 pl-4">
            <div class="row">
                <div class="form-group col-md-6">
                    <label for="squareInput1">Image</label>
                    <input asp-for="ImageURL" type="file" id="squareInput1" class="form-control">
                </div>

                <div class="form-group col-md-6">
                    <label for="squareInput1">Title</label>
                    <input asp-for="Title" type="text" id="squareInput1" class="form-control">
                </div>
            </div>
            <div class="row">
               
                <div class="form-group col-md-12">
                    <label for="wordEditor">Description</label>
                    <textarea asp-for="Description" id="editor"></textarea>
                </div>
            </div>
            <hr />
            <div class="d-flex justify-content-start">
                <button class="btn btn-success">Save</button>
            </div>
        </div>

    </form>

</div>
