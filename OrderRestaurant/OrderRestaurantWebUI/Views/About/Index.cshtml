@model OrderRestaurantWebUI.Dtos.AboutDto.ResultAboutDto
@{
    ViewData["ActiveA"] = "active";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}
<section class="about">

    <div class="about-image">
        <img src="@Model.ImageURL" alt="About">
    </div>

    <div class="about-content">
        <h2>@Model.Title</h2>

        <p>
            @Html.Raw(Model.Description)
        </p>
        <a href="/About/UpdateAbout/@Model.AboutID" class="btn btn-primary">Update</a>
    </div>

</section>