@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model OrderRestaurantWebUI.Dtos.SocialMediaDto.UpdateSocialMediaDto
@{
    ViewData["Title"] = "Update Social";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}S

<div class="card col-md-12">
    <form method="post">
        <div class="card-body">
            <input asp-for="SocialMediaId" hidden/>
            <div class="row">
                <div class="form-group col-md-6">
                    <label for="largeInput">Icon</label>
                    <input asp-for="Icon" type="text" class="form-control">
                </div>
                <div class="form-group col-md-6">
                    <label for="largeInput">Color</label>
                    <input asp-for="Color" type="text" class="form-control">
                </div>
            </div>
            <div class="form-group col-md-12">
                <label for="largeInput">URL</label>
                <input asp-for="URL" type="text" class="form-control">
            </div>
        </div>
        <div class="card-action">
            <button class="btn btn-success">Save</button>
        </div>
    </form>
</div>