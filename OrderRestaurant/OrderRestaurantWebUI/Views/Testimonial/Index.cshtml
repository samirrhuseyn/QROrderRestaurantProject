@model IPagedList<OrderRestaurantWebUI.Dtos.TestimonialDto.ResultTestimonialDto>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using X.PagedList
@using X.PagedList.Mvc.Core
@{
    ViewData["Title"] = "Testimonials";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}
<link href="~/ready-bootstrap-dashboard-master/assets/css/testimonialstyle.css" rel="stylesheet" />
<div class="about-grid">
    @foreach (var item in Model)
    {
        <div class="about-card">

            <div class="about-header">
                <div class="about-avatar">
                    @if(item.ImageURL == "null")
                    {
                        <i class="la la-user"></i>
                        
                    }
                    else
                    {
                        <img src="@item.ImageURL" />
                    }
                </div>
                <div>
                    <h3>@item.Name</h3>
                    @if (item.IsActive == true)
                    {
                        <form asp-action="ChangeIsPassive" method="post">
                            <input type="hidden" name="id" value="@item.TestimonialId" />
                            <button style="margin-left:40px;" type="submit" class="btn btn-success btn-xs">
                                Active
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="ChangeIsActive" method="post">
                            <input type="hidden" name="id" value="@item.TestimonialId" />
                            <button style="margin-left:40px;" type="submit" class="btn btn-danger btn-xs">
                                Passive
                            </button>
                        </form>
                    }
                </div>

                <div class="about-buttons">
                    <a href="/Testimonial/UpdateTestimonial/@item.TestimonialId" class="btn btn-primary"><i class="la la-pencil"></i></a>
                    <a href="/Testimonial/DeleteTestimonial/@item.TestimonialId" class="btn btn-danger"><i class="la la-trash"></i></a>
                </div>
            </div>

            <p>
                @Html.Raw(item.Comment)
            </p>

        </div>
    }
</div>
<nav>
    @Html.PagedListPager(
    Model,
    page => Url.Action("Index", new { page }),
                    new PagedListRenderOptions
                    {
                        UlElementClasses = new[] { "pagination", "justify-content-center" },
                        LiElementClasses = new[] { "page-item" },
                        PageClasses = new[] { "page-link" }
                    })
</nav>
