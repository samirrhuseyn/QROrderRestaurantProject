@model OrderRestaurantWebUI.Dtos.ProductDtos.UpdateProductDto
@{
    ViewData["Title"] = "Update Product";
    ViewData["ActiveP"] = "active";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="card">
    <form method="post">
        <div class="card-body col-md-12 pr-4 pl-4">
            <div class="row">
                <div class="form-group col-md-6">
                    <input asp-for="ProductId" hidden/>
                    <label for="squareInput1">Name</label>
                    <input asp-for="ProductName" type="text" id="squareInput1" class="form-control">
                </div>

                <div class="form-group col-md-6">
                    <label for="solidSelect">Category</label>
                    <select asp-for="CategoryId" asp-items="ViewBag.dropvalue" class="form-control input-solid" id="solidSelect">
                    </select>
                </div>
            </div>
            <div class="row">
                <div class="form-group col-md-6">
                    <label for="squareInput1">Price</label>
                    <input asp-for="ProductPrice" type="text" id="squareInput1" class="form-control">
                </div>

                <div class="form-group col-md-6">
                    <label for="squareInput1">Image</label>
                    <input asp-for="ImageURL" type="text" id="squareInput1" class="form-control">
                </div>
                <div class="form-group col-md-12">
                    <label for="wordEditor">Description</label>
                    <textarea asp-for="ProductDescription" id="editor"></textarea>
                </div>
            </div>
            <hr />
            <div class="d-flex justify-content-start">
                <button class="btn btn-success">Save</button>
            </div>
        </div>

    </form>

</div>