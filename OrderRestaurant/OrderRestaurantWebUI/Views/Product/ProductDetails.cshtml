@model OrderRestaurantWebUI.Dtos.ProductDtos.ResultProductWithCategory
@{
    ViewData["Title"] = "Product Details";
    ViewData["ActiveP"] = "active";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}
<div style="height:65vh">
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <div class="row align-items-center">

                <div class="col-12 col-md-4 text-center">
                    <img src="@Model.ImageURL"
                         class="img-fluid rounded"
                         alt="Product Image"
                         style="max-height: 220px; width: auto; object-fit: contain;">
                </div>

                <div class="col-12 col-md-8 mt-3 mt-md-0">
                    <h3 class="fw-semibold text-dark mb-1">@Model.ProductName</h3>

                    <p class="text-muted mb-3">
                        Category: <strong class="text-secondary">@Model.CategoryName</strong>
                    </p>

                    <div class="text-secondary mb-3" style="font-size: 0.95rem;">
                        @Html.Raw(Model.ProductDescription)
                    </div>

                    <h4 class="fw-bold text-dark mb-3">@Model.ProductPrice.ToString("0.00") ₼</h4>

                    <div>
                        @if (Model.IsActive)
                        {
                            <span class="btn btn-primary px-4 py-2 fw-medium disabled" style="opacity: 1;">Active</span>
                        }
                        else
                        {
                            <span class="btn btn-danger px-4 py-2 fw-medium disabled" style="opacity: 1;">Passive</span>
                        }
                    </div>
                </div>

            </div>

        </div>
    </div>
</div>