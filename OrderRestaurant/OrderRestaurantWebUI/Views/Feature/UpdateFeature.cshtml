@model OrderRestaurantWebUI.Dtos.FeatureDto.UpdateFeatureDto
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Create Feature";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}
<div class="card col-md-12">
    <form method="post">
        <div class="card-body">
            <input asp-for="FeatureID" hidden />
            <div class="form-group">
                <label for="largeInput">Title</label>
                <input asp-for="FeatureTitle" type="text" class="form-control">
            </div>
            <div class="form-group">
                <label for="largeInput">Description</label>
                <textarea asp-for="FeatureDescription" id="editor"></textarea>
            </div>
        </div>
        <div class="card-action">
            <button class="btn btn-success">Save</button>
        </div>
    </form>
</div>