@model IPagedList<OrderRestaurantWebUI.Dtos.FeatureDto.ResultFeatureDto>
@using X.PagedList
@using X.PagedList.Mvc.Core
@{
    ViewData["Title"] = "Features";
    ViewData["Link"] = "/Feature/CreateFeature/";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}
<link href="~/ready-bootstrap-dashboard-master/assets/css/featuresstyle.css" rel="stylesheet" />
<div class="info-cards-wrapper col-lg-12">
    @foreach (var item in Model)
    {
        <div class="info-card col-lg-6">
            <div class="info-card-header">
                <h5>@item.FeatureTitle</h5>

                <div class="info-card-actions">
                    <a href="/Feature/UpdateFeature/@item.FeatureID" class="btn-pencil"><i class="la la-pencil"></i></a>
                    <a href="/Feature/DeleteFeature/@item.FeatureID" class="btn-trash"><i class="la la-trash"></i></a>
                </div>
            </div>

            <p>
                @Html.Raw(item.FeatureDescription)
            </p>
        </div>
    }
</div>
<nav>
    @Html.PagedListPager(
    Model,
    page => Url.Action("Index", new { page }),
                new PagedListRenderOptions
                {
                    UlElementClasses = new[] { "pagination", "justify-content-center" },
                    LiElementClasses = new[] { "page-item" },
                    PageClasses = new[] { "page-link" }
                })
</nav>