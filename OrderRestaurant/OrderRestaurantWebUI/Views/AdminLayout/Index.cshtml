@{
    Layout = null;
}

<!DOCTYPE html>
<html>
@await Component.InvokeAsync("_LayoutHeaderComponentPartial")
<body>
    <div class="wrapper">

        @await Component.InvokeAsync("_LayoutNavbarComponentPartial")

        @await Component.InvokeAsync("_LayoutSidebarComponentsPartial")

        <div class="main-panel">
            <div class="content">
                <div class="container-fluid">
                    <h4 class="page-title">
                        @ViewBag.Title
                        @if(ViewBag.Link != null)
                        {
                            <a style="margin-left:1000px" href="@ViewBag.Link" class="btn btn-default">Create</a>
                        }
                        else
                        {
                            
                        }
                    </h4>
                    @RenderBody()
                </div>
            </div>

            @await Component.InvokeAsync("_LayoutFooterComponentPartial")

        </div>
    </div>
</body>
@await Component.InvokeAsync("_LayoutScriptComponentPartial")
</html>
