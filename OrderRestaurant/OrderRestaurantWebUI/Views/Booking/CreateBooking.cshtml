@model OrderRestaurantWebUI.Dtos.BookingDtos.CreateBookingDto
@{
    ViewData["Title"] = "Create Booking";
    ViewData["ActiveB"] = "active";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}
<div class="card">
    <form method="post">
        <div class="card-body col-md-12 pr-4 pl-4">
            <div class="row">
                <div class="form-group col-md-6">
                    <label for="squareInput1">Name</label>
                    <input asp-for="Name" type="text" id="squareInput1" class="form-control">
                </div>
                <div class="form-group col-md-6">
                    <label for="squareInput1">Phone Number</label>
                    <input asp-for="PhoneNumber" type="tel" id="squareInput1" class="form-control">
                </div>

            </div>
            <div class="row">
               
                <div class="form-group col-md-6">
                    <label for="squareInput1">Mail</label>
                    <input asp-for="Mail" type="email" id="squareInput1" class="form-control">
                </div>
                <div class="form-group col-md-6">
                    <label for="squareInput1">Person Count</label>
                    <input asp-for="PersonCount" type="number" id="squareInput1" class="form-control">
                </div>
            </div>
            <hr />
            <div class="d-flex justify-content-start">
                <button class="btn btn-success">Save</button>
            </div>
        </div>

    </form>

</div>
